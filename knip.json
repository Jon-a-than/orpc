{
  "$schema": "node_modules/knip/schema.json",
  "drizzle": true,
  "nitro": true,
  "tags": ["-lintignore"],
  "vitest": true,
  "workspaces": {
    "apps/*": {
      "entry": ["src/plugins/*.ts", "src/error.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"]
    }
  }
}
