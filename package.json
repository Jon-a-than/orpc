{
  "name": "template",
  "type": "module",
  "version": "0.0.0",
  "description": "a lib template for typescript",
  "author": {
    "name": "qingshaner",
    "url": "https://github.com/Jon-a-than"
  },
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run '/^build:/'",
    "build:api": "pnpm --filter=api build",
    "build:web": "pnpm --filter=web build",
    "changeset-version": "changeset version",
    "changeset-publish": "changeset publish",
    "check": "biome check . --write",
    "check:cspell": "cspell . --no-summary --no-progress --gitignore",
    "check:type": "tsc --build --noEmit",
    "check:knip": "knip",
    "dev": "pnpm run '/^dev:/'",
    "dev:api": "pnpm --filter=api dev",
    "dev:web": "pnpm --filter=web dev",
    "prepare": "simple-git-hooks",
    "preview": "pnpm --filter=api preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@qingshaner/devtools": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "knip": "^6.44.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged",
    "pre-push": "pnpm run '/^(test|check.*)$/'"
  },
  "nano-staged": {
    "*": "pnpm cspell --no-summary --no-progress --no-must-find-files --file-list",
    "*.{json,jsonc,js,jsx,cjs,mjs,ts,tsx,cts,md,yaml,yml,mts,html,svg,css,vue}": "pnpm biome check --fix --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "packageManager": "pnpm@12.11.2"
}
